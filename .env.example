# Copy to .env.local (gitignored). Each phase adds what it needs; see docs/plans/.

# ── Site ─────────────────────────────────────────────────────────────────────
# Canonical origin. Production: https://www.sayfy.cz (apex redirects to www).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Database (MongoDB Atlas — same cluster as the legacy backend) ─── Phase 1 ──
# The APP reads MONGODB_URI. Locally it MUST point at the cloned TEST database
# (name contains "test"), never production. See docs/05 §Test database.
MONGODB_URI="mongodb+srv://<USER>:<PASSWORD>@cluster0.oahmw.mongodb.net/sayfy-next-test?retryWrites=true&w=majority"
# Only for scripts/clone-prod-to-test.ts — read-only user on the legacy DB.
MONGODB_URI_PROD=""
# Optional: known password set on the cloned admin(s) for Phase 2 login testing.
TEST_ADMIN_PASSWORD=""

# ── Auth.js v5 ────────────────────────────────────────────────────── Phase 2 ──
# Generate with: npx auth secret   (replaces legacy JWT_SECRET / REFRESH_TOKEN_*)
AUTH_SECRET=""

# ── AWS S3 (bucket sayfyho-memorial, eu-central-1) ─────────────────── Phase 3 ──
# Locally use a TEST bucket + its own IAM user (docs/aws/README.md).
AWS_REGION="eu-central-1"
AWS_BUCKET_NAME=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Host used to build public URLs of new uploads (legacy rows use the S3 host).
S3_PUBLIC_HOST="sayfyho-memorial.s3.eu-central-1.amazonaws.com"

# ── Rate limiting (Upstash Redis — admin login) ─────────────────────── Phase 2 ──
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
